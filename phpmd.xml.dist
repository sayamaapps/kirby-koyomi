<?xml version="1.0"?>
<ruleset name="Koyomi"
	xmlns="http://pmd.sf.net/ruleset/1.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
	xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
	<description>PHP Mess Detector rules for Koyomi. Every exclusion and raised threshold has its reason here.</description>

	<rule ref="rulesets/cleancode.xml">
		<!-- Options, I18n, Format, Time and Normalize are static helpers by design, as in Kirby's own code. -->
		<exclude name="StaticAccess" />
		<!-- Boolean arguments are event fields and option switches; they are part of the public API. -->
		<exclude name="BooleanArgumentFlag" />
		<!-- The assignment in a condition keeps the candidate lookup in reading order. -->
		<exclude name="IfStatementAssignment" />
		<!-- An else branch reads better than an early return in the formatters and the status cascade. -->
		<exclude name="ElseExpression" />
	</rule>

	<!-- codesize: NPathComplexity is not used, the cyclomatic complexity below covers the same branching. -->
	<rule ref="rulesets/codesize.xml/CyclomaticComplexity">
		<!-- Open: twelve methods reach 11 to 17 (Ics::vevent, Filters::fromQuery, Format::configure,
		     Options::formats, Event::fromArray, Event::series and others), because each branches on
		     purpose. Splitting them is a follow-up; 18 keeps any new method from growing past the current maximum. -->
		<properties>
			<property name="reportLevel" value="18" />
		</properties>
	</rule>
	<rule ref="rulesets/codesize.xml">
		<!-- Event's constructor takes every field of an event; the signature is public API. -->
		<exclude name="ExcessiveParameterList" />
		<!-- Set above: the exceptions are listed on their rules. -->
		<exclude name="CyclomaticComplexity" />
		<exclude name="NPathComplexity" />
		<!-- Format, Ics, Options and Event are large by design (one file per output format or setting group); splitting them is a follow-up. -->
		<exclude name="ExcessiveClassComplexity" />
		<exclude name="TooManyPublicMethods" />
		<exclude name="TooManyMethods" />
	</rule>

	<rule ref="rulesets/design.xml">
		<!-- The public domain classes (Event, Options, Blueprints) keep their public methods; splitting them changes the API. -->
		<exclude name="TooManyPublicMethods" />
		<exclude name="TooManyMethods" />
		<exclude name="CouplingBetweenObjects" />
	</rule>

	<rule ref="rulesets/naming.xml">
		<!-- Short names are the variables of the calendar formulas (day, month, year) and array keys in tables. -->
		<exclude name="ShortVariable" />
		<!-- I18n::t() is the translation shorthand used in snippets and tests. -->
		<exclude name="ShortMethodName" />
	</rule>

	<rule ref="rulesets/unusedcode.xml">
		<!-- The Blueprints builders take the settings for one signature, also the ones that do not need them. -->
		<exclude name="UnusedFormalParameter" />
	</rule>
</ruleset>
