{
    "name": "sayamaapps/kirby-koyomi",
    "description": "Event calendar for Kirby 5: venues, organizers, status, online events, ICS, RSS and JSON-LD.",
    "type": "kirby-plugin",
    "license": "MIT",
    "keywords": [
        "kirby",
        "kirby-plugin",
        "kirby-5",
        "events",
        "calendar",
        "ics",
        "icalendar",
        "json-ld",
        "schema-org",
        "privacy"
    ],
    "homepage": "https://github.com/sayamaapps/kirby-koyomi",
    "authors": [
        {
            "name": "Simon Räder",
            "homepage": "https://sayamaapps.de"
        }
    ],
    "support": {
        "issues": "https://github.com/sayamaapps/kirby-koyomi/issues",
        "source": "https://github.com/sayamaapps/kirby-koyomi"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "getkirby/composer-installer": "^1.2"
    },
    "require-dev": {
        "getkirby/cms": "^5.0",
        "phpunit/phpunit": "11.5.55"
    },
    "conflict": {
        "sayamaapps/kirby-fude": "<1.7"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "getkirby/composer-installer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "extra": {
        "installer-name": "koyomi",
        "kirby-cms-path": false,
        "kirby": {
            "compatible": "^5.0"
        }
    }
}
